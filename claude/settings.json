{
  "autoMemoryEnabled": false,
  "outputStyle": "Gentleman",
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.production)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.test)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(//**/*serviceAccount*.json)",
      "Read(//**/*service-account*.json)",
      "Read(//**/*credentials*.json)",
      "Read(//**/.netrc)",
      "Read(//**/.npmrc)",
      "Read(//**/.pypirc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.claude.json)",
      "Read(~/.config/restic/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(//**/.env.*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  }
}
