+
+/// The number for a standard uppercase numeral (as `to_roman` writes it), or
+/// `None` for anything else.
+pub fn from_roman(s: &str) -> Option<u32> {
+    let mut rest = s;
+    let mut n = 0;
+    for &(value, symbol) in NUMERALS.iter() {
+        while let Some(tail) = rest.strip_prefix(symbol) {
+            n += value;
+            rest = tail;
+        }
+    }
+    // Greedy parsing accepts forms like "IIII"; only the canonical one counts.
+    if !rest.is_empty() || to_roman(n).as_deref() != Some(s) {
+        return None;
+    }
+    Some(n)
+}
