diff --git a/src/size.c b/src/size.c
index b15511b..83781b4 100644
--- a/src/size.c
+++ b/src/size.c
@@ -3,9 +3,22 @@
 #include <limits.h>
 #include <stddef.h>
 
+/* unit_shift: log2 of the multiplier for a unit letter, or -1. */
+static int unit_shift(char c)
+{
+	switch (c) {
+	case 'K': case 'k': return 10;
+	case 'M': case 'm': return 20;
+	case 'G': case 'g': return 30;
+	case 'T': case 't': return 40;
+	default: return -1;
+	}
+}
+
 int parse_size(const char *s, unsigned long long *out)
 {
 	unsigned long long n = 0;
+	int shift = 0;
 	const char *p = s;
 
 	if (s == NULL || *s == '\0')
@@ -16,8 +29,15 @@ int parse_size(const char *s, unsigned long long *out)
 			return -1;
 		n = n * 10 + digit;
 	}
-	if (p == s || *p != '\0')
+	if (p == s)
 		return -1;
-	*out = n;
+	if (*p != '\0') {
+		shift = unit_shift(*p);
+		if (shift < 0 || p[1] != '\0')
+			return -1;
+		if (n > (ULLONG_MAX >> shift))
+			return -1;
+	}
+	*out = n << shift;
 	return 0;
 }
diff --git a/src/size.h b/src/size.h
