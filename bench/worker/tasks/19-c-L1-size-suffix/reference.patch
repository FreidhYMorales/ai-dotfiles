+++ b/src/size.h
@@ -2,7 +2,8 @@
 #define SIZE_H
 
 /*
- * parse_size: parse a byte count such as "4096" into *out.
+ * parse_size: parse a byte count such as "4096" or "4K" into *out. One
+ * optional unit suffix K, M, G or T (any case) multiplies by 1024^1..4.
  * Returns 0 on success, -1 on invalid input or overflow (then *out is left
  * unchanged).
  */
