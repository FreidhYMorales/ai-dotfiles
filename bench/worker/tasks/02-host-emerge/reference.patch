diff --git a/plugins/toolkit/hooks/host-info.sh b/plugins/toolkit/hooks/host-info.sh
index 06949dc..15247dd 100755
--- a/plugins/toolkit/hooks/host-info.sh
+++ b/plugins/toolkit/hooks/host-info.sh
@@ -49,7 +49,7 @@ esac
 os=${os% }
 
 managers=()
-for pm in pacman apt dnf zypper apk nix brew winget scoop choco; do
+for pm in pacman apt dnf zypper apk emerge nix brew winget scoop choco; do
   has "$pm" && managers+=("$pm")
 done
 packages=unknown
