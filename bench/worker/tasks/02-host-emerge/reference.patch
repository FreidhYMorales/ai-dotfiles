 assert 'ubuntu: names apt' has 'packages: apt'
 assert 'ubuntu: no AUR helper' lacks 'AUR'
 
+dir=$(host gentoo Linux emerge)
+printf 'PRETTY_NAME="Gentoo Linux"\nID=gentoo\n' >"$dir/os-release"
+run "$dir"
+assert 'gentoo: names the distro' has 'Gentoo Linux'
+assert 'gentoo: names emerge' has 'packages: emerge'
+
 dir=$(host wsl Linux apt)
