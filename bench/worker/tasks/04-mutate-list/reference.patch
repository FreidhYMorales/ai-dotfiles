-    mutated=${line/"${FROM[k]}"/"${TO[k]}"}
-    mutant=("${lines[@]}")
-    mutant[i]=$mutated
-    printf '%s\n' "${mutant[@]}" >"$file"
-    total=$((total + 1))
-    if run_tests "$@"; then
-      printf 'SURVIVED line %d: %s\n' "$((i + 1))" "${mutated#"${mutated%%[![:space:]]*}"}"
-    else
-      killed=$((killed + 1))
-    fi
-  done
-done
+while IFS= read -r rec; do
+  i=${rec%%$'\t'*}
+  mutated=${rec#*$'\t'}
+  mutant=("${lines[@]}")
+  mutant[i]=$mutated
+  printf '%s\n' "${mutant[@]}" >"$file"
+  total=$((total + 1))
+  if run_tests "$@"; then
+    printf 'SURVIVED line %d: %s\n' "$((i + 1))" "$(trim "$mutated")"
+  else
+    killed=$((killed + 1))
+  fi
+done < <(mutants "${lines[@]}")
 printf '%s\n' "${lines[@]}" >"$file"
 
