+-- lighten: add `amount` to each channel of a #rrggbb color, clamped to 0..255
+-- (a negative amount darkens). Returns lowercase #rrggbb.
+function M.lighten(hex, amount)
+	local rgb = hex_to_rgb(hex)
+	for i = 1, 3 do
+		rgb[i] = math.min(255, math.max(0, rgb[i] + amount))
+	end
+	return string.format("#%02x%02x%02x", rgb[1], rgb[2], rgb[3])
+end
