 	local pat = "^#(" .. hex_type .. ")(" .. hex_type .. ")(" .. hex_type .. ")$"
 	hex = string.lower(hex)
 
+	-- Shorthand #rgb means #rrggbb.
+	local r, g, b = string.match(hex, "^#(%x)(%x)(%x)$")
