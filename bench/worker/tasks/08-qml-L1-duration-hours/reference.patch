@@ -0,0 +1,18 @@
+.pragma library
+
+// Time formatting shared by the QML components.
+
+// formatDuration: seconds as m:ss under an hour, h:mm:ss from one hour.
+// Fractions are floored; negative, NaN or missing input gives "0:00".
+function formatDuration(seconds) {
+    const total = Math.floor(Number(seconds))
+    if (!(total > 0))
+        return "0:00"
+    const h = Math.floor(total / 3600)
+    const m = Math.floor((total % 3600) / 60)
+    const s = total % 60
+    const ss = String(s).padStart(2, "0")
+    if (h > 0)
+        return `${h}:${String(m).padStart(2, "0")}:${ss}`
+    return `${m}:${ss}`
+}
