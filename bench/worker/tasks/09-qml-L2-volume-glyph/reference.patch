index 0000000..b7ed983
--- /dev/null
+++ b/dotfiles/quickshell/.config/quickshell/utils/volume.js
@@ -0,0 +1,17 @@
+.pragma library
+
+// Volume icon shared by the bar widget and the volume OSD.
+
+// volumeGlyph: Nerd Font glyph for a volume percentage (may exceed 100 when
+// PipeWire boosts the sink). Muted or 0% shows the muted glyph.
+function volumeGlyph(volume, muted) {
+    if (muted || volume <= 0)
+        return "\u{F0581}"
+    if (volume > 100)
+        return "\u{F075D}"
+    if (volume > 66)
+        return "\u{F057E}"
+    if (volume > 33)
+        return "\u{F0580}"
+    return "\u{F057F}"
+}
