#!/usr/bin/env bash
# Safely update the AI tooling: Claude Code plugins and the engram binary.
#   - Plugins: refresh every marketplace, then update installed plugins that
#     are older than their marketplace manifest.
#   - engram: download the latest GitHub release, verify its checksum, back up
#     the database (sqlite3 VACUUM INTO) and the binary, swap it atomically, verify
#     the version (rolling back on mismatch), run `engram doctor`, and restart
#     a running `engram serve`.
#   - OpenCode and Antigravity: rerun install.sh for the installed ones (by
#     config dir), so their generated build follows the repo after a pull;
#     without a prompt, since it only rebuilds derived files.
# Shows the plan and asks once. A MAJOR engram bump always asks, even with --yes.
#
# Usage: ai-update [--check] [--yes]
#   --check  refresh the marketplace catalogs, report available updates and
#            exit; installs nothing
#   --yes    do not ask for minor/patch updates
set -euo pipefail

CHECK=0
YES=0
for arg in "$@"; do
  case $arg in
    --check) CHECK=1 ;;
    --yes) YES=1 ;;
    -h | --help)
      sed -n '2,17p' "$0" | cut -c3-
      exit 0
      ;;
    *)
      echo "unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

ENGRAM_REPO=${ENGRAM_REPO:-Gentleman-Programming/engram}
ENGRAM_BIN=${ENGRAM_BIN:-$(command -v engram || true)}
ENGRAM_DATA_DIR=${ENGRAM_DATA_DIR:-$HOME/.engram}
PLUGINS_DIR=${CLAUDE_PLUGINS_DIR:-$HOME/.claude/plugins}
UPDATE_CHECK_CACHE=${UPDATE_CHECK_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/ai-dotfiles/engram-latest}
# The repo this script is linked from: its install.sh regenerates the agent build.
REPO_DIR=${AI_DOTFILES_DIR:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}
BUILD_DIR=${AI_BUILD_DIR:-$REPO_DIR/build/agents}
OPENCODE_DIR=${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}
ANTIGRAVITY_DIR=${ANTIGRAVITY_CONFIG_DIR:-$HOME/.gemini/antigravity-cli}

require() {
  command -v "$1" >/dev/null || {
    echo "missing dependency: $1" >&2
    exit 1
  }
}

# newer A B: true when version A is strictly newer than B.
newer() {
  [[ -n $1 && -n $2 && $1 != "$2" ]] &&
    [[ $(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1) == "$1" ]]
}

platform() {
  if [[ -n ${AI_UPDATE_PLATFORM:-} ]]; then
    echo "$AI_UPDATE_PLATFORM"
    return
  fi
  local os arch
  os=$(uname -s | tr '[:upper:]' '[:lower:]')
  case $(uname -m) in
    x86_64 | amd64) arch=amd64 ;;
    aarch64 | arm64) arch=arm64 ;;
    *) arch=$(uname -m) ;;
  esac
  echo "${os}_${arch}"
}

# outdated_plugins: "<name@marketplace> <installed> <available>" per outdated plugin.
outdated_plugins() {
  local installed=$PLUGINS_DIR/installed_plugins.json known=$PLUGINS_DIR/known_marketplaces.json
  local key version location available
  [[ -f $installed && -f $known ]] || return 0
  while read -r key version; do
    location=$(jq -r --arg m "${key#*@}" '.[$m].installLocation // empty' "$known")
    [[ -n $location ]] || continue
    available=$(jq -r --arg n "${key%@*}" \
      'first(.plugins[]? | select(.name == $n) | .version // empty)' \
      "$location/.claude-plugin/marketplace.json" 2>/dev/null || true)
    if newer "$available" "$version"; then echo "$key $version $available"; fi
  done < <(jq -r '.plugins // {} | to_entries[] | "\(.key) \(.value[0].version // "")"' "$installed")
}

refresh_marketplaces() {
  local known=$PLUGINS_DIR/known_marketplaces.json name
  [[ -f $known ]] || return 0
  while read -r name; do
    claude plugin marketplace update "$name" >/dev/null 2>&1 ||
      echo "warning: could not refresh marketplace $name" >&2
  done < <(jq -r 'keys[]' "$known")
}

latest_engram() {
  curl -fsSL --max-time 10 "https://api.github.com/repos/$ENGRAM_REPO/releases/latest" 2>/dev/null |
    jq -r '.tag_name // empty' 2>/dev/null | sed 's/^v//'
}

confirm() {
  local answer
  printf '%s [y/N] ' "$1"
  read -r answer || answer=""
  [[ $answer == [yY]* ]]
}

restart_server() {
  [[ ${AI_UPDATE_RESTART_SERVER:-1} == 1 ]] || return 0
  local pids
  pids=$(pgrep -x -f 'engram serve' || true)
  [[ -n $pids ]] || return 0
  # shellcheck disable=SC2086 # one pid per word
  kill $pids
  mkdir -p "$ENGRAM_DATA_DIR"
  setsid "$ENGRAM_BIN" serve >/dev/null 2>>"$ENGRAM_DATA_DIR/serve.err.log" </dev/null &
  echo "restarted: engram serve"
}

# prune_copies: keep the two newest database copies and binary copies, matching
# only the exact names upgrade_engram makes.
prune_copies() {
  compgen -G "$HOME/.engram-backup-*" | rg '/\.engram-backup-[0-9]{8}-[0-9]{6}$' |
    sort | head -n -2 | xargs -r -d '\n' rm -rf --
  compgen -G "$ENGRAM_BIN-*.bak" | rg -e '-[0-9]+\.[0-9]+\.[0-9]+[^/]*\.bak$' |
    sort -V | head -n -2 | xargs -r -d '\n' rm -f --
}

# doctor_reports_errors: true when the report counts errors. Doctor exits 0 even
# when blocked, and warnings or blocked checks can predate the update, so they
# pass; an unreadable report is no evidence of a failure, only a warning.
doctor_reports_errors() {
  local errors
  errors=$("$ENGRAM_BIN" doctor --json </dev/null 2>/dev/null | jq -r '.summary.errors' 2>/dev/null || true)
  if [[ ! $errors =~ ^[0-9]+$ ]]; then
    echo "warning: could not read the engram doctor report" >&2
    return 1
  fi
  ((errors > 0))
}

# offer_restore CURRENT BACKUP: always ask, even with --yes, because memories
# saved since BACKUP are overwritten; then put the binary and database back.
offer_restore() {
  local current=$1 backup=$2 tmp_bin tmp_db
  confirm "Restore engram $current and the database from before the update? Memories saved since then are lost." || return 0
  tmp_bin=$(dirname "$ENGRAM_BIN")/.engram.new
  tmp_db=$ENGRAM_DATA_DIR/.engram.db.restore
  # Prepare both before replacing either: all or nothing.
  if cp -p "$ENGRAM_BIN-$current.bak" "$tmp_bin" && cp -p "$backup/engram.db" "$tmp_db" &&
    mv -f "$tmp_bin" "$ENGRAM_BIN" && mv -f "$tmp_db" "$ENGRAM_DATA_DIR/engram.db" &&
    rm -f "$ENGRAM_DATA_DIR/engram.db-wal" "$ENGRAM_DATA_DIR/engram.db-shm"; then
    echo "restored: engram $current and the database. Restart Claude Code: open sessions still hold the replaced database."
  else
    rm -f "$tmp_bin" "$tmp_db"
    echo "error: restore failed; copies kept: $ENGRAM_BIN-$current.bak and $backup/engram.db" >&2
  fi
}

# upgrade_engram CURRENT LATEST: verified, backed-up, atomic swap with rollback.
upgrade_engram() {
  local current=$1 latest=$2 work asset base stamp backup dir
  work=$(mktemp -d)
  # shellcheck disable=SC2064 # expand $work now
  trap "rm -rf '$work'" RETURN
  asset="engram_${latest}_$(platform).tar.gz"
  base="https://github.com/$ENGRAM_REPO/releases/download/v$latest"

  echo "downloading $asset"
  if ! curl -fsSL --max-time 120 -o "$work/$asset" "$base/$asset" ||
    ! curl -fsSL --max-time 30 -o "$work/checksums.txt" "$base/checksums.txt"; then
    echo "error: download failed; engram unchanged" >&2
    return 1
  fi
  if ! (cd "$work" && rg -F "  $asset" checksums.txt | sha256sum -c --status 2>/dev/null); then
    echo "error: checksum mismatch for $asset; engram unchanged" >&2
    return 1
  fi
  tar -xzf "$work/$asset" -C "$work" engram

  stamp=$(date +%Y%m%d-%H%M%S)
  backup="$HOME/.engram-backup-$stamp"
  mkdir -p "$backup"
  if [[ -f $ENGRAM_DATA_DIR/engram.db ]]; then
    # VACUUM INTO, like engram-backup: a consistent copy without the deleted
    # rows that engram's sqlite leaves in free pages.
    sqlite3 "$ENGRAM_DATA_DIR/engram.db" "VACUUM INTO '${backup//\'/\'\'}/engram.db'"
  fi
  echo "backed up: database -> $backup"
  cp -p "$ENGRAM_BIN" "$ENGRAM_BIN-$current.bak"
  echo "backed up: binary -> $ENGRAM_BIN-$current.bak"

  dir=$(dirname "$ENGRAM_BIN")
  install -m 755 "$work/engram" "$dir/.engram.new"
  mv -f "$dir/.engram.new" "$ENGRAM_BIN"

  local installed
  installed=$("$ENGRAM_BIN" version 2>/dev/null | awk '{print $2}' || true)
  if [[ ${installed#v} != "$latest" ]]; then
    cp -p "$ENGRAM_BIN-$current.bak" "$ENGRAM_BIN"
    echo "error: new binary does not report $latest; rolled back to $current" >&2
    offer_restore "$current" "$backup"
    return 1
  fi
  echo "installed: engram $latest"
  if ! "$ENGRAM_BIN" doctor </dev/null 2>&1 | tail -n 5 || doctor_reports_errors; then
    echo "error: engram doctor failed" >&2
    offer_restore "$current" "$backup"
    return 1
  fi
  rm -f "$UPDATE_CHECK_CACHE"
  prune_copies
  restart_server
}

main() {
  require jq
  require curl
  require rg

  local plugin_lines=() line current="" latest="" major=0 plan=()
  # Refresh the catalogs even for --check: comparing against a stale catalog
  # misses releases published since the last refresh. It installs nothing.
  require claude
  refresh_marketplaces
  while IFS= read -r line; do [[ -n $line ]] && plugin_lines+=("$line"); done < <(outdated_plugins)
  for line in "${plugin_lines[@]}"; do
    read -r key from to <<<"$line"
    plan+=("plugin $key $from -> $to")
  done

  if [[ -n $ENGRAM_BIN && -x $ENGRAM_BIN ]]; then
    current=$("$ENGRAM_BIN" version 2>/dev/null | awk '{print $2}')
    current=${current#v}
    latest=$(latest_engram || true)
    if [[ -z $latest ]]; then
      echo "warning: could not check the latest engram release" >&2
    elif newer "$latest" "$current"; then
      if [[ ${latest%%.*} != "${current%%.*}" ]]; then
        major=1
        plan+=("engram $current -> $latest (MAJOR: read the release notes first)")
      else
        plan+=("engram $current -> $latest")
      fi
    fi
  fi

  if ((${#plan[@]} == 0)); then
    echo "Everything is up to date."
    return 0
  fi
  echo "Updates available:"
  printf '  - %s\n' "${plan[@]}"
  ((CHECK)) && return 0

  if ((major)); then
    confirm "MAJOR engram upgrade. Proceed?" || {
      echo "aborted"
      return 0
    }
  elif ((YES == 0)); then
    confirm "Apply these updates?" || {
      echo "aborted"
      return 0
    }
  fi

  local status=0
  for line in "${plugin_lines[@]}"; do
    read -r key _ <<<"$line"
    claude plugin update "$key" || status=1
  done
  if [[ -n $latest ]] && newer "$latest" "$current"; then
    require sha256sum
    require sqlite3
    upgrade_engram "$current" "$latest" || status=1
  fi
  ((status == 0)) && echo "done. Restart Claude Code to load the updates."
  return "$status"
}

# regenerate_agents: rerun install.sh for the installed OpenCode and Antigravity
# targets, so their generated build follows the repo after a pull.
regenerate_agents() {
  local targets=() before
  [[ -d $OPENCODE_DIR ]] && targets+=(opencode)
  [[ -d $ANTIGRAVITY_DIR ]] && targets+=(antigravity)
  ((${#targets[@]})) || return 0
  before=$(build_hash)
  bash "$REPO_DIR/install.sh" --target "$(
    IFS=,
    echo "${targets[*]}"
  )" || return 1
  [[ $(build_hash) == "$before" ]] || echo "Restart OpenCode to load the new build."
}

# build_hash: one checksum over the names and contents of the generated files.
build_hash() {
  [[ -d $BUILD_DIR ]] || return 0
  (cd "$BUILD_DIR" && rg --files -uu -L | sort | xargs -r -d '\n' sha256sum) | sha256sum
}

# Regenerate first: `main || ...` would turn off set -e inside main.
regen_status=0
((CHECK)) || regenerate_agents || regen_status=1
main
exit "$regen_status"
