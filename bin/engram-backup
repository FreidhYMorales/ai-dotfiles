#!/usr/bin/env bash
# Back up the engram database to every configured restic repository.
#   - Takes a consistent copy with `sqlite3 .backup` (safe while engram runs).
#   - Backs it up to each repository in ENGRAM_BACKUP_REPOS; one failing
#     repository does not stop the others, but the run exits non-zero.
#   - Skips the snapshot when nothing changed; keeps 7 daily, 4 weekly and
#     12 monthly snapshots.
#
# Usage: engram-backup [--init | --verify | --scan | --restore [--force]]
#   --init    create the password file (if missing) and every repository
#   --verify  check each repository, restore the latest snapshot and check
#             the restored database
#   --scan    run gitleaks over a dump of the database; prints a redacted
#             summary and exits 1 when it finds secrets
#   --restore [--force]  put the latest snapshot back into the engram data
#             dir (new machine); --force replaces existing data, keeping it
#             aside as <data dir>.before-restore-<time>
#
# Config: ~/.config/restic/engram.env, e.g.
#   ENGRAM_BACKUP_REPOS="/home/me/Files/backups/restic-engram rclone:gdrive:backups/restic-engram"
# Password: ~/.config/restic/engram.pass (created by --init; keep a copy in a
# password manager: without it the backups cannot be restored).
set -uo pipefail

MODE=backup
case ${1:-} in
  "") ;;
  --init) MODE=init ;;
  --verify) MODE=verify ;;
  --scan) MODE=scan ;;
  --restore)
    MODE=restore
    [[ ${2:-} == --force ]] && FORCE=1
    ;;
  -h | --help)
    # The leading comment block, up to the first non-comment line.
    awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"
    exit 0
    ;;
  *)
    echo "unknown argument: $1" >&2
    exit 2
    ;;
esac

CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/restic
CONFIG=${ENGRAM_BACKUP_CONFIG:-$CONFIG_DIR/engram.env}
DATA_DIR=${ENGRAM_DATA_DIR:-$HOME/.engram}
STAGING=${XDG_CACHE_HOME:-$HOME/.cache}/engram-backup/snapshot
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/engram-backup
HOST=${HOSTNAME:-$(uname -n)}
GITLEAKS=${ENGRAM_BACKUP_GITLEAKS:-gitleaks}
failed=()
SCAN_DIR=""
# The plaintext dump must never outlive the run.
trap 'rm -rf "$SCAN_DIR"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

for tool in restic sqlite3 jq; do
  command -v "$tool" >/dev/null || {
    echo "missing dependency: $tool" >&2
    exit 1
  }
done

if [[ ! -f $CONFIG ]]; then
  echo "error: $CONFIG not found. Create engram.env with:" >&2
  echo '  ENGRAM_BACKUP_REPOS="/path/to/repo rclone:<remote>:<path>"' >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$CONFIG"
[[ -n ${ENGRAM_BACKUP_REPOS:-} ]] || {
  echo "error: ENGRAM_BACKUP_REPOS is empty in $CONFIG" >&2
  exit 1
}
export RESTIC_PASSWORD_FILE=${RESTIC_PASSWORD_FILE:-$(dirname "$CONFIG")/engram.pass}
read -r -a REPOS <<<"$ENGRAM_BACKUP_REPOS"

init() {
  if [[ ! -s $RESTIC_PASSWORD_FILE ]]; then
    mkdir -p "$(dirname "$RESTIC_PASSWORD_FILE")"
    (umask 077 && openssl rand -base64 32 >"$RESTIC_PASSWORD_FILE")
    echo "created: $RESTIC_PASSWORD_FILE"
    echo "IMPORTANT: copy this password to your password manager now; without it the backups cannot be restored."
  fi
  local repo
  for repo in "${REPOS[@]}"; do
    if restic -r "$repo" cat config >/dev/null 2>&1; then
      echo "ok: $repo"
    elif restic -r "$repo" init --quiet >/dev/null; then
      echo "created: $repo"
    else
      failed+=("$repo")
    fi
  done
}

# stage: take a consistent copy of the engram data into $STAGING.
stage() {
  if [[ ! -f $DATA_DIR/engram.db ]]; then
    echo "error: engram.db not found in $DATA_DIR" >&2
    failed+=("$DATA_DIR/engram.db (not found)")
    return 1
  fi
  rm -rf "$STAGING" && mkdir -p "$STAGING"
  sqlite3 "$DATA_DIR/engram.db" ".backup '$STAGING/engram.db'" || exit 1
  [[ -f $DATA_DIR/protocol-mode.json ]] && cp "$DATA_DIR/protocol-mode.json" "$STAGING/"
  return 0
}

# secret_scan: run gitleaks over a text dump of the staged database, print a
# redacted summary and record scan.json. Returns 0 when clean, 1 when secrets
# were found, 2 when the scan could not run.
secret_scan() {
  local findings=0 rc=0 report line row where rule
  if ! command -v "$GITLEAKS" >/dev/null; then
    echo "error: gitleaks not installed (sudo pacman -S gitleaks); cannot scan for secrets" >&2
    rc=2
  else
    SCAN_DIR=$(mktemp -d) || exit 1
    chmod 700 "$SCAN_DIR"
    mkdir "$SCAN_DIR/src"
    report="$SCAN_DIR/report.json"
    if ! sqlite3 "$STAGING/engram.db" .dump >"$SCAN_DIR/src/engram.sql"; then
      echo "error: could not dump the database for the secret scan" >&2
      rc=2
    else
      "$GITLEAKS" detect --no-git --redact --no-banner --source "$SCAN_DIR/src" \
        --report-format json --report-path "$report" >"$SCAN_DIR/gitleaks.log" 2>&1
      if ! findings=$(jq -er 'length' "$report" 2>/dev/null); then
        echo "error: gitleaks failed:" >&2
        sed 's/^/  /' "$SCAN_DIR/gitleaks.log" >&2
        findings=0 rc=2
      elif ((findings)); then
        rc=1
        echo "secrets found in the engram database: $findings finding(s)"
        while IFS=$'\t' read -r rule line; do
          # Name the row by table and numeric id only: never echo the content.
          row=$(sed -n "${line}p" "$SCAN_DIR/src/engram.sql")
          where="line $line of the dump"
          if [[ $row =~ ^INSERT\ INTO\ \"?([A-Za-z0-9_]+)\"?\ VALUES\(([0-9]+), ]]; then
            where="${BASH_REMATCH[1]} id=${BASH_REMATCH[2]}"
          fi
          echo "  $rule in $where"
        done < <(jq -r '.[] | [.RuleID, .StartLine] | @tsv' "$report")
        echo "remove or redact those observations, then run: engram-backup --scan"
      else
        echo "no secrets found in the engram database"
      fi
    fi
    rm -rf "$SCAN_DIR"
    SCAN_DIR=""
  fi
  mkdir -p "$STATE_DIR"
  jq -n --arg time "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson findings "$findings" --argjson rc "$rc" \
    '{mode: "scan", time: $time, ok: ($rc == 0), findings: $findings}
      + (if $rc == 2 then {error: "scan could not run"} else {} end)' \
    >"$STATE_DIR/scan.json.tmp" && mv -f "$STATE_DIR/scan.json.tmp" "$STATE_DIR/scan.json"
  return "$rc"
}

scan() {
  stage || return
  local rc=0
  secret_scan || rc=$?
  rm -rf "$STAGING"
  case $rc in
    1) failed+=("secrets found") ;;
    2) failed+=("secret scan") ;;
  esac
}

backup() {
  stage || return
  local repo digest state
  digest=$(cat "$STAGING"/* | sha256sum | cut -d' ' -f1)
  mkdir -p "$STATE_DIR"
  for repo in "${REPOS[@]}"; do
    # Content-based skip: every .backup copy has fresh metadata, so restic's
    # own --skip-if-unchanged would never skip.
    state="$STATE_DIR/$(printf '%s' "$repo" | sha256sum | cut -c1-16)"
    if [[ -f $state && $(<"$state") == "$digest" ]]; then
      echo "unchanged: $repo"
    elif restic -r "$repo" backup "$STAGING" --tag engram --host "$HOST" --quiet &&
      restic -r "$repo" forget --tag engram --keep-daily 7 --keep-weekly 4 --keep-monthly 12 \
        --prune --quiet >/dev/null; then
      printf '%s\n' "$digest" >"$state"
      echo "backed up: $repo"
    else
      failed+=("$repo")
    fi
  done
  rm -rf "$STAGING"
}

verify() {
  local repo work db count
  for repo in "${REPOS[@]}"; do
    work=$(mktemp -d)
    db=""
    if restic -r "$repo" check --quiet >/dev/null &&
      restic -r "$repo" restore latest --tag engram --target "$work" --quiet >/dev/null; then
      db=$(find "$work" -name engram.db -type f | head -n1)
    fi
    if [[ -n $db && $(sqlite3 "$db" 'PRAGMA integrity_check;') == ok ]]; then
      count=$(sqlite3 "$db" 'SELECT count(*) FROM observations;' 2>/dev/null || echo "?")
      echo "verified: $repo (integrity ok, $count observation(s))"
    else
      failed+=("$repo")
    fi
    rm -rf "$work"
  done
}

restore() {
  local repo work db stamp
  if [[ -e $DATA_DIR/engram.db && ${FORCE:-0} != 1 ]]; then
    echo "error: $DATA_DIR/engram.db already exists; rerun with --restore --force to replace it (the old data is kept aside)" >&2
    failed+=("$DATA_DIR (exists)")
    return
  fi
  if [[ ${ENGRAM_BACKUP_ALLOW_RUNNING:-} != 1 ]] && pgrep -f 'engram (serve|mcp)' >/dev/null 2>&1; then
    echo "error: engram is running; close every Claude Code session (and stop 'engram serve') before restoring" >&2
    failed+=("engram running")
    return
  fi
  for repo in "${REPOS[@]}"; do
    work=$(mktemp -d)
    if restic -r "$repo" restore latest --tag engram --target "$work" --quiet >/dev/null 2>&1; then
      db=$(find "$work" -name engram.db -type f | head -n1)
      if [[ -n $db && $(sqlite3 "$db" 'PRAGMA integrity_check;') == ok ]]; then
        if [[ -e $DATA_DIR ]]; then
          stamp=$(date +%Y%m%d-%H%M%S)
          mv "$DATA_DIR" "${DATA_DIR%/}.before-restore-$stamp"
          echo "kept the old data at ${DATA_DIR%/}.before-restore-$stamp"
        fi
        mkdir -p "$DATA_DIR"
        cp -a "$(dirname "$db")/." "$DATA_DIR/"
        echo "restored: $repo -> $DATA_DIR ($(sqlite3 "$DATA_DIR/engram.db" 'SELECT count(*) FROM observations;' 2>/dev/null || echo '?') observation(s))"
        rm -rf "$work"
        return
      fi
    fi
    rm -rf "$work"
    failed+=("$repo")
  done
}

"$MODE"

# Record the outcome for the toolkit backup-status hook (backup.json, verify.json).
if [[ $MODE != init && $MODE != scan ]]; then
  mkdir -p "$STATE_DIR"
  status_file="$STATE_DIR/$MODE.json"
  jq -n --arg mode "$MODE" --arg time "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson failed "$(printf '%s\n' "${failed[@]}" | jq -R . | jq -sc 'map(select(length > 0))')" \
    '{mode: $mode, time: $time, ok: ($failed | length == 0), failed: $failed}' \
    >"$status_file.tmp" && mv -f "$status_file.tmp" "$status_file"
fi

if ((${#failed[@]})); then
  printf 'error: %s failed for: %s\n' "$MODE" "${failed[*]}" >&2
  exit 1
fi
