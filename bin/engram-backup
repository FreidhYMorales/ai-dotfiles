#!/usr/bin/env bash
# Back up the engram database to every configured restic repository.
#   - Takes a consistent, compacted copy with `VACUUM INTO` (safe while engram
#     runs; deleted rows left in free pages are not copied, so what is backed
#     up is exactly what the secret scan sees).
#   - Backs it up to each repository in ENGRAM_BACKUP_REPOS; one failing
#     repository does not stop the others, but the run exits non-zero.
#   - Skips the snapshot when nothing changed; keeps 7 daily, 4 weekly and
#     12 monthly snapshots.
#
# Off-site: a repository that is the root of a git clone with a remote (e.g.
# a private GitHub repo) is committed and pushed after each backup, but only
# when a gitleaks scan of the database finds no secrets; otherwise it is
# skipped and the run fails. A failed commit or push is retried on the next
# run. --verify and --restore use the clone as is. The scan reads every user
# text value of every table, one per line, skipping BLOBs, FTS index tables
# and columns engram derives (normalized_hash, sync_id, embedding*). It uses
# gitleaks' built-in rules only; it cannot catch secrets they do not match
# (split tokens, plain passwords), and a SIGKILL can leave its text copy in
# $TMPDIR.
#
# Usage: engram-backup [--init | --verify | --scan | --restore [--force]]
#   --init    create the password file (if missing) and every repository;
#             in an empty off-site clone also commit and push the new repo
#   --verify  check each repository, restore the latest snapshot and check
#             the restored database
#   --scan    run gitleaks over the database's user text, one value per
#             line; prints a redacted summary (rule, table and row id) and
#             exits 1 when it finds secrets
#   --restore [--force]  put the latest snapshot back into the engram data
#             dir (new machine); --force replaces existing data, keeping it
#             aside as <data dir>.before-restore-<time>
#
# Config: ~/.config/restic/engram.env, e.g.
#   ENGRAM_BACKUP_REPOS="/home/me/Files/backups/restic-engram /home/me/Files/backups/restic-engram-git"
# (the second one a clone of a private git repo; rclone:<remote>:<path> works too)
# Password: ~/.config/restic/engram.pass (created by --init; keep a copy in a
# password manager: without it the backups cannot be restored).
set -uo pipefail

MODE=backup
case ${1:-} in
  "") ;;
  --init) MODE=init ;;
  --verify) MODE=verify ;;
  --scan) MODE=scan ;;
  --restore)
    MODE=restore
    [[ ${2:-} == --force ]] && FORCE=1
    ;;
  -h | --help)
    # The leading comment block, up to the first non-comment line.
    awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"
    exit 0
    ;;
  *)
    echo "unknown argument: $1" >&2
    exit 2
    ;;
esac

CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/restic
CONFIG=${ENGRAM_BACKUP_CONFIG:-$CONFIG_DIR/engram.env}
DATA_DIR=${ENGRAM_DATA_DIR:-$HOME/.engram}
STAGING=${XDG_CACHE_HOME:-$HOME/.cache}/engram-backup/snapshot
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/engram-backup
HOST=${HOSTNAME:-$(uname -n)}
GITLEAKS=${ENGRAM_BACKUP_GITLEAKS:-gitleaks}
failed=()
SCAN_DIR=""
# The plaintext dump must never outlive the run.
trap 'rm -rf "$SCAN_DIR"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

for tool in restic sqlite3 jq; do
  command -v "$tool" >/dev/null || {
    echo "missing dependency: $tool" >&2
    exit 1
  }
done

if [[ ! -f $CONFIG ]]; then
  echo "error: $CONFIG not found. Create engram.env with:" >&2
  echo '  ENGRAM_BACKUP_REPOS="/path/to/repo rclone:<remote>:<path>"' >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$CONFIG"
[[ -n ${ENGRAM_BACKUP_REPOS:-} ]] || {
  echo "error: ENGRAM_BACKUP_REPOS is empty in $CONFIG" >&2
  exit 1
}
export RESTIC_PASSWORD_FILE=${RESTIC_PASSWORD_FILE:-$(dirname "$CONFIG")/engram.pass}
read -r -a REPOS <<<"$ENGRAM_BACKUP_REPOS"

init() {
  if [[ ! -s $RESTIC_PASSWORD_FILE ]]; then
    mkdir -p "$(dirname "$RESTIC_PASSWORD_FILE")"
    (umask 077 && openssl rand -base64 32 >"$RESTIC_PASSWORD_FILE")
    echo "created: $RESTIC_PASSWORD_FILE"
    echo "IMPORTANT: copy this password to your password manager now; without it the backups cannot be restored."
  fi
  local repo
  for repo in "${REPOS[@]}"; do
    if restic -r "$repo" cat config >/dev/null 2>&1; then
      echo "ok: $repo"
    elif restic -r "$repo" init --quiet >/dev/null; then
      echo "created: $repo"
      if is_offsite "$repo" && ! git_publish "$repo" "init restic repository"; then
        failed+=("$repo (commit or push failed)")
      fi
    else
      failed+=("$repo")
    fi
  done
}

# stage: take a consistent copy of the engram data into $STAGING.
stage() {
  if [[ ! -f $DATA_DIR/engram.db ]]; then
    echo "error: engram.db not found in $DATA_DIR" >&2
    failed+=("$DATA_DIR/engram.db (not found)")
    return 1
  fi
  rm -rf "$STAGING" && mkdir -p "$STAGING"
  local target="$STAGING/engram.db"
  sqlite3 "$DATA_DIR/engram.db" "VACUUM INTO '${target//\'/\'\'}'" || exit 1
  [[ -f $DATA_DIR/protocol-mode.json ]] && cp "$DATA_DIR/protocol-mode.json" "$STAGING/"
  return 0
}

# The scan source query: for each table holding user text, a SELECT that
# prints each row as a "@MARK@ <table> id=<rowid>" line followed by one
# "<table>.<column> | <value>" line per value (NULLs left out). Skipped:
# sqlite_* tables, FTS index shadow tables (their text lives in the indexed
# table; a contentful FTS table's own _content table is kept), BLOB columns
# and columns engram derives itself (normalized_hash, sync_id, embedding*).
# The separator is not an assignment, so a column named *_key or *token*
# gives gitleaks no keyword context for its value.
read -r -d '' SCAN_SQL <<'SQL'
WITH t AS (
  SELECT name, wr FROM pragma_table_list
  WHERE schema = 'main' AND name NOT LIKE 'sqlite\_%' ESCAPE '\'
    AND (type = 'table' OR (type = 'shadow' AND name LIKE '%\_content' ESCAPE '\'))
), c AS (
  SELECT t.name AS tbl, t.wr AS wr,
    'ifnull(char(10) || ' || quote(t.name || '.' || p.name || ' | ') ||
      ' || "' || replace(p.name, '"', '""') || '", '''')' AS expr
  FROM t JOIN pragma_table_info(t.name) AS p
  WHERE p.name NOT IN ('normalized_hash', 'sync_id') AND p.name NOT LIKE 'embedding%'
    AND upper(p.type) <> 'BLOB'
  ORDER BY t.name, p.cid
)
SELECT 'SELECT ' || quote('@MARK@ ' || tbl || iif(wr, ' row=', ' id=')) || ' || ' ||
  iif(wr, 'row_number() OVER ()', 'rowid') || ' || ' || group_concat(expr, ' || ') ||
  ' FROM "' || replace(tbl, '"', '""') || '";'
FROM c GROUP BY tbl ORDER BY tbl;
SQL

# scan_source DB MARK: print DB's user text as described for SCAN_SQL.
scan_source() {
  local queries
  queries=$(sqlite3 -bail "$1" "${SCAN_SQL//@MARK@/$2}") || return 1
  [[ -z $queries ]] || sqlite3 -bail "$1" <<<"$queries"
}

# secret_scan [LEVEL]: run gitleaks over a text copy of the staged database,
# print a redacted summary and record scan.json. LEVEL prefixes the message
# when gitleaks is missing (error by default). Returns 0 when clean, 1 when
# secrets were found, 2 when the scan could not run.
secret_scan() {
  local findings=0 rc=0 status=0 report line where rule var mark unset_env=()
  if ! command -v "$GITLEAKS" >/dev/null; then
    echo "${1:-error}: gitleaks not installed (sudo pacman -S gitleaks); cannot scan for secrets" >&2
    rc=2
  else
    SCAN_DIR=$(mktemp -d) || exit 1
    chmod 700 "$SCAN_DIR"
    mkdir "$SCAN_DIR/src"
    report="$SCAN_DIR/report.json"
    # Row headers carry a per-run mark, so a line in a memory cannot pose as one.
    mark="#row-$(od -An -N8 -tu8 /dev/urandom | tr -d ' ')"
    if ! scan_source "$STAGING/engram.db" "$mark" >"$SCAN_DIR/src/engram.txt"; then
      echo "error: could not dump the database for the secret scan" >&2
      rc=2
    else
      # Built-in rules only: drop GITLEAKS_* overrides from the environment,
      # ignore .gitleaksignore files outside the scan dir and gitleaks:allow
      # markers (a memory could contain one).
      for var in $(compgen -e); do
        [[ $var == GITLEAKS_* ]] && unset_env+=(-u "$var")
      done
      env "${unset_env[@]}" "$GITLEAKS" detect --no-git --redact --no-banner --ignore-gitleaks-allow \
        --gitleaks-ignore-path "$SCAN_DIR" --source "$SCAN_DIR/src" \
        --report-format json --report-path "$report" >"$SCAN_DIR/gitleaks.log" 2>&1 || status=$?
      # Trust only "exit 0, no findings" and "exit 1, findings".
      if ! findings=$(jq -er 'length' "$report" 2>/dev/null) ||
        ! { ((status == 0 && findings == 0)) || ((status == 1 && findings > 0)); }; then
        echo "error: the secret scan could not run (gitleaks exit $status):" >&2
        sed 's/^/  /' "$SCAN_DIR/gitleaks.log" >&2
        findings=0 rc=2
      elif ((findings)); then
        rc=1
        echo "secrets found in the engram database: $findings finding(s)"
        while IFS=$'\t' read -r rule line; do
          # Name the row by table and numeric id only: never echo the content.
          where=$(awk -v n="$line" -v m="$mark " \
            'index($0, m) == 1 { h = substr($0, length(m) + 1) } NR == n { print h; exit }' \
            "$SCAN_DIR/src/engram.txt")
          [[ -n $where ]] || where="line $line of the scan source"
          echo "  $rule in $where"
        done < <(jq -r '.[] | [.RuleID, .StartLine] | @tsv' "$report")
        echo "remove or redact those observations, then run: engram-backup --scan"
      else
        echo "no secrets found in the engram database"
      fi
    fi
    rm -rf "$SCAN_DIR"
    SCAN_DIR=""
  fi
  mkdir -p "$STATE_DIR"
  jq -n --arg time "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson findings "$findings" --argjson rc "$rc" \
    '{mode: "scan", time: $time, ok: ($rc == 0), findings: $findings}
      + (if $rc == 2 then {error: "scan could not run"} else {} end)' \
    >"$STATE_DIR/scan.json.tmp" && mv -f "$STATE_DIR/scan.json.tmp" "$STATE_DIR/scan.json"
  return "$rc"
}

scan() {
  stage || return
  local rc=0
  secret_scan || rc=$?
  rm -rf "$STAGING"
  case $rc in
    1) failed+=("secrets found") ;;
    2) failed+=("secret scan") ;;
  esac
}

# is_offsite DIR: DIR is the root of a git work tree with a remote; its
# restic repo is committed and pushed after each backup.
is_offsite() {
  local top
  [[ -d $1 ]] || return 1
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || return 1
  [[ $top == "$(cd "$1" && pwd -P)" && -n $(git -C "$1" remote 2>/dev/null) ]]
}

# gitr DIR ARGS...: git in DIR, with a fallback identity when it has none.
gitr() {
  local dir=$1 id=()
  shift
  if [[ -z $(git -C "$dir" config user.name) || -z $(git -C "$dir" config user.email) ]]; then
    id=(-c user.name=engram-backup -c user.email=engram-backup@localhost)
  fi
  git -C "$dir" "${id[@]}" "$@"
}

# git_pending DIR: DIR has commits its upstream does not (or no upstream yet).
git_pending() {
  git -C "$1" rev-parse -q --verify HEAD >/dev/null || return 1
  git -C "$1" rev-parse -q --verify '@{u}' >/dev/null 2>&1 || return 0
  (($(git -C "$1" rev-list --count '@{u}..HEAD') > 0))
}

# git_push DIR: push to the upstream, setting it on the first push. Never
# prompts: under the timer there is nobody to answer.
git_push() {
  local remotes remote
  if git -C "$1" rev-parse -q --verify '@{u}' >/dev/null 2>&1; then
    GIT_TERMINAL_PROMPT=0 git -C "$1" push -q || return 1
  else
    mapfile -t remotes < <(git -C "$1" remote)
    remote=${remotes[0]}
    [[ " ${remotes[*]} " == *" origin "* ]] && remote=origin
    GIT_TERMINAL_PROMPT=0 git -C "$1" push -q -u "$remote" HEAD || return 1
  fi
  echo "pushed: $1"
}

# ensure_gitignore DIR: DIR/.gitignore lists restic's locks/ directory.
ensure_gitignore() {
  local file="$1/.gitignore" line
  if [[ -f $file ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      [[ $line == locks/ ]] && return 0
    done <"$file"
    [[ -s $file && $(tail -c1 "$file") != "" ]] && echo >>"$file"
  fi
  echo 'locks/' >>"$file"
}

# git_publish DIR MESSAGE: commit DIR's restic repo (when it changed) and push.
# Returns 1 when the commit failed, 2 when the push failed.
git_publish() {
  ensure_gitignore "$1"
  gitr "$1" add -A || return 1
  if ! gitr "$1" diff --cached --quiet; then
    gitr "$1" commit -q -m "$2" || return 1
  fi
  git_pending "$1" || return 0
  git_push "$1" || return 2
}

# publish REPO: git_publish an off-site repo, recording a failure.
publish() {
  local rc=0
  git_publish "$1" "backup $HOST $(date -u +%Y-%m-%dT%H:%M:%SZ)" || rc=$?
  case $rc in
    0) ;;
    1) failed+=("$1 (commit failed)") ;;
    *) failed+=("$1 (push failed)") ;;
  esac
}

# unpublished DIR: DIR has uncommitted changes or unpushed commits left by an
# earlier run whose commit or push failed.
unpublished() {
  [[ -n $(git -C "$1" status --porcelain 2>/dev/null) ]] || git_pending "$1"
}

backup() {
  stage || return
  local repo digest state offsite scanned=0 rc blocked=""
  digest=$(cat "$STAGING"/* | sha256sum | cut -d' ' -f1)
  mkdir -p "$STATE_DIR"
  for repo in "${REPOS[@]}"; do
    # Content-based skip: every copy is a new file, so restic's
    # own --skip-if-unchanged would never skip.
    state="$STATE_DIR/$(printf '%s' "$repo" | sha256sum | cut -c1-16)"
    offsite=0
    is_offsite "$repo" && offsite=1
    if [[ -f $state && $(<"$state") == "$digest" ]]; then
      # A commit or push that failed last time is retried now; the data was
      # scanned clean when it was backed up.
      if ((offsite)) && unpublished "$repo"; then
        publish "$repo"
      else
        echo "unchanged: $repo"
      fi
      continue
    fi
    if ((offsite)); then
      # Scan once, before the first off-site repo: a secret saved by mistake
      # must not leave the machine.
      if ((! scanned)); then
        scanned=1 rc=0
        secret_scan warning || rc=$?
        case $rc in
          0) ;;
          1) blocked="blocked: secrets found, see engram-backup --scan" ;;
          *) blocked="blocked: secret scan could not run, see engram-backup --scan" ;;
        esac
      fi
      if [[ -n $blocked ]]; then
        echo "skipped: $repo ($blocked)" >&2
        failed+=("$repo ($blocked)")
        continue
      fi
    fi
    if restic -r "$repo" backup "$STAGING" --tag engram --host "$HOST" --quiet &&
      restic -r "$repo" forget --tag engram --keep-daily 7 --keep-weekly 4 --keep-monthly 12 \
        --prune --quiet >/dev/null; then
      printf '%s\n' "$digest" >"$state"
      echo "backed up: $repo"
      ((offsite)) && publish "$repo"
    else
      failed+=("$repo")
    fi
  done
  rm -rf "$STAGING"
}

verify() {
  local repo work db count
  for repo in "${REPOS[@]}"; do
    work=$(mktemp -d)
    db=""
    if restic -r "$repo" check --quiet >/dev/null &&
      restic -r "$repo" restore latest --tag engram --target "$work" --quiet >/dev/null; then
      db=$(find "$work" -name engram.db -type f | head -n1)
    fi
    if [[ -n $db && $(sqlite3 "$db" 'PRAGMA integrity_check;') == ok ]]; then
      count=$(sqlite3 "$db" 'SELECT count(*) FROM observations;' 2>/dev/null || echo "?")
      echo "verified: $repo (integrity ok, $count observation(s))"
    else
      failed+=("$repo")
    fi
    rm -rf "$work"
  done
}

restore() {
  local repo work db stamp
  if [[ -e $DATA_DIR/engram.db && ${FORCE:-0} != 1 ]]; then
    echo "error: $DATA_DIR/engram.db already exists; rerun with --restore --force to replace it (the old data is kept aside)" >&2
    failed+=("$DATA_DIR (exists)")
    return
  fi
  if [[ ${ENGRAM_BACKUP_ALLOW_RUNNING:-} != 1 ]] && pgrep -f 'engram (serve|mcp)' >/dev/null 2>&1; then
    echo "error: engram is running; close every Claude Code session (and stop 'engram serve') before restoring" >&2
    failed+=("engram running")
    return
  fi
  for repo in "${REPOS[@]}"; do
    work=$(mktemp -d)
    if restic -r "$repo" restore latest --tag engram --target "$work" --quiet >/dev/null 2>&1; then
      db=$(find "$work" -name engram.db -type f | head -n1)
      if [[ -n $db && $(sqlite3 "$db" 'PRAGMA integrity_check;') == ok ]]; then
        if [[ -e $DATA_DIR ]]; then
          stamp=$(date +%Y%m%d-%H%M%S)
          mv "$DATA_DIR" "${DATA_DIR%/}.before-restore-$stamp"
          echo "kept the old data at ${DATA_DIR%/}.before-restore-$stamp"
        fi
        mkdir -p "$DATA_DIR"
        cp -a "$(dirname "$db")/." "$DATA_DIR/"
        echo "restored: $repo -> $DATA_DIR ($(sqlite3 "$DATA_DIR/engram.db" 'SELECT count(*) FROM observations;' 2>/dev/null || echo '?') observation(s))"
        rm -rf "$work"
        return
      fi
    fi
    rm -rf "$work"
    failed+=("$repo")
  done
}

# One run at a time: the backup and verify timers can fire together (both
# missed while the machine was off), and restic's exclusive lock would make one
# of them fail. Wait for the other run instead.
mkdir -p "$STATE_DIR"
exec 8>"$STATE_DIR/run.lock"
lock_wait=${ENGRAM_BACKUP_LOCK_WAIT:-600}
if ! flock -w "$lock_wait" 8; then
  echo "error: another engram-backup run is still active (waited ${lock_wait}s); try again later" >&2
  exit 1
fi

"$MODE"

# Record the outcome for the toolkit backup-status hook (backup.json, verify.json).
if [[ $MODE != init && $MODE != scan ]]; then
  mkdir -p "$STATE_DIR"
  status_file="$STATE_DIR/$MODE.json"
  jq -n --arg mode "$MODE" --arg time "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson failed "$(printf '%s\n' "${failed[@]}" | jq -R . | jq -sc 'map(select(length > 0))')" \
    '{mode: $mode, time: $time, ok: ($failed | length == 0), failed: $failed}' \
    >"$status_file.tmp" && mv -f "$status_file.tmp" "$status_file"
fi

if ((${#failed[@]})); then
  printf 'error: %s failed for: %s\n' "$MODE" "${failed[*]}" >&2
  exit 1
fi
