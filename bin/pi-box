#!/usr/bin/env bash
# Run pi (or any command) in a bubblewrap sandbox confined to the project.
#   - Read-write: only the project (the git root, or the current folder).
#   - Read-only: the system (/usr, /etc), the pi install (~/.pi/agent), so
#     pi cannot rewrite its own config, and the project's .git, so no config
#     key or hook planted here runs when git is used on the host.
#   - Invisible: the rest of HOME (~/.ssh, ~/.config/gh, restic password,
#     ~/.claude, sibling projects) and the host /tmp.
#   - Sessions go to ~/.local/state/pi-box/sessions.
#   - Network: none, except ollama bridged in as 127.0.0.1:11434 (needs socat;
#     PI_BOX_OLLAMA=host:port for another server). PI_BOX_NETWORK=host shares
#     the full host network instead.
#
# Usage: pi-box [pi args...]        run pi
#        pi-box -- CMD [ARGS...]    run another command (e.g. bash) in the box
set -euo pipefail

command -v bwrap >/dev/null || {
  echo "missing dependency: bwrap (sudo pacman -S bubblewrap)" >&2
  exit 1
}

pi_dir=${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}
root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
# The project becomes writable, so it must never be HOME, / or a parent of HOME.
case "$HOME/" in
  "${root%/}/"*)
    echo "pi-box: refusing to open $root: it contains HOME, so nothing would be confined. Run it from a project folder." >&2
    exit 1
    ;;
esac
state=${XDG_STATE_HOME:-$HOME/.local/state}/pi-box
mkdir -p "$state/sessions"

if [[ ${1:-} == -- ]]; then
  shift
  cmd=("$@")
else
  cmd=("$pi_dir/bin/pi" "$@")
fi

args=(
  --ro-bind /usr /usr
  --symlink usr/bin /bin
  --symlink usr/bin /sbin
  --symlink usr/lib /lib
  --symlink usr/lib /lib64
  --ro-bind /etc /etc
  --ro-bind-try /opt /opt
  --proc /proc
  --dev /dev
  --tmpfs /tmp
  --tmpfs "$HOME"
  --overlay-src "$pi_dir" --tmp-overlay "$pi_dir"
  --bind "$state" "$state"
  --bind "$root" "$root"
  --ro-bind-try "$root/.git" "$root/.git"
  --chdir "$PWD"
  --setenv HOME "$HOME"
  --setenv PATH "$pi_dir/bin:/usr/local/bin:/usr/bin"
  --setenv PI_CODING_AGENT_SESSION_DIR "$state/sessions"
  --unshare-all
  --die-with-parent
)
# A core.hooksPath inside the project (e.g. a dotfiles repo's git-hooks/ set
# globally) runs in every host repo, so it is read-only too.
hooks=$(git -C "$root" rev-parse --path-format=absolute --git-path hooks 2>/dev/null || true)
if [[ -n $hooks && $hooks == "${root%/}/"* && $hooks != "${root%/}/.git/"* ]]; then
  if [[ ! -e $hooks ]]; then
    echo "pi-box: refusing to open $root: core.hooksPath ($hooks) is inside it but does not exist, so the box could create it. Create it first." >&2
    exit 1
  fi
  # Bind its top folder below the root: a deeper mount point alone would let
  # the box rename a parent and rebuild the path.
  rel=${hooks#"${root%/}/"}
  top="${root%/}/${rel%%/*}"
  args+=(--ro-bind "$top" "$top")
fi
# Without the kernel's TIOCSTI block, a sandboxed process could inject input
# into the parent terminal; a new session prevents that (at the cost of job control).
if [[ $(sysctl -n dev.tty.legacy_tiocsti 2>/dev/null || echo 1) != 0 ]]; then
  args+=(--new-session)
fi

network=${PI_BOX_NETWORK:-ollama}
if [[ $network == host ]]; then
  exec bwrap "${args[@]}" --share-net --ro-bind-try /run/systemd/resolve /run/systemd/resolve "${cmd[@]}"
fi

# Default: no network at all, except one bridge to ollama. Outside, socat maps
# a private Unix socket to ollama; inside, a second socat republishes it as
# 127.0.0.1:11434, so pi talks to "local ollama" and reaches nothing else.
# The host DNS resolver (/run/systemd/resolve) stays unmounted: DNS queries
# would otherwise be a way to send data out.
command -v socat >/dev/null || {
  echo "pi-box: socat is needed for the ollama-only network (sudo pacman -S socat), or set PI_BOX_NETWORK=host" >&2
  exit 1
}
ollama=${PI_BOX_OLLAMA:-127.0.0.1:11434}
net_dir=$(mktemp -d "$state/net.XXXXXX")
socat "UNIX-LISTEN:$net_dir/ollama.sock,fork,mode=600" "TCP:$ollama" 2>/dev/null &
bridge=$!
trap 'kill "$bridge" 2>/dev/null; rm -rf "$net_dir"' EXIT
for _ in $(seq 50); do
  [[ -S $net_dir/ollama.sock ]] && break
  sleep 0.05
done

# shellcheck disable=SC2016 # expanded by the inner bash, inside the box.
inner='socat TCP-LISTEN:11434,bind=127.0.0.1,fork,reuseaddr UNIX-CONNECT:/run/pi-box/ollama.sock 2>/dev/null &
for _ in $(seq 50); do (exec 3<>/dev/tcp/127.0.0.1/11434) 2>/dev/null && break; sleep 0.05; done
"$@"'
bwrap "${args[@]}" --bind "$net_dir" /run/pi-box bash -c "$inner" pi-box "${cmd[@]}"
